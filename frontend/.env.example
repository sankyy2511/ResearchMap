# Copy to frontend/.env.local. Public values only — NEVER put API keys here (everything NEXT_PUBLIC_* ships to the browser).
# mock = in-browser demo backend, http = real Go backend
NEXT_PUBLIC_API_MODE=http
# Server-only: in http mode Next.js rewrites /api/* to the Go backend (same-origin httpOnly cookie)
API_PROXY_TARGET=http://localhost:8080
# WebSocket endpoint of the Go backend
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
# ID of the unpacked extension (fixed by the "key" in extension/manifest.json)
NEXT_PUBLIC_EXTENSION_ID=bfphemfnigknpgmhiaknanilpjiifjlp
# API base the extension uses for /capture/* calls (Bearer extension token)
NEXT_PUBLIC_EXTENSION_API_BASE=http://localhost:8080/api/v1
