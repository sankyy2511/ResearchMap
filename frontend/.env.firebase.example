# Settings for the live web app on Firebase Hosting. Copy to .env.firebase and fill in.
# These values are public (they are built into the web page). Never put secrets here.
NEXT_PUBLIC_API_MODE=http
# The public address of the backend, ending in /api/v1
NEXT_PUBLIC_API_BASE_URL=https://YOUR-BACKEND-ADDRESS/api/v1
# Live updates; leave empty to derive it from the address above
NEXT_PUBLIC_WS_URL=
# Chrome extension id (fixed by the key in extension/manifest.json)
NEXT_PUBLIC_EXTENSION_ID=bfphemfnigknpgmhiaknanilpjiifjlp
# Leave empty: the extension uses the backend address above
NEXT_PUBLIC_EXTENSION_API_BASE=
