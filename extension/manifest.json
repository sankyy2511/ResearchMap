{
  "manifest_version": 3,
  "name": "Research Map",
  "version": "1.1.8",
  "description": "Turns your research tabs into a live knowledge map. Tracks only when you press Start Tracking.",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "idle", "scripting", "activeTab", "tabCapture", "declarativeNetRequest", "contextMenus", "webNavigation", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Research Map" },
  "externally_connectable": { "matches": ["https://researhmap.in/*", "https://www.researhmap.in/*", "https://research-map-88f54.web.app/*", "https://research-map-88f54.firebaseapp.com/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"] },
  "commands": {
    "add-page": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Add this page to the workspace now" },
    "go-live": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Show this tab live in the workspace" },
    "pause": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Pause or resume tracking" }
  }
}
