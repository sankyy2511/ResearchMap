# ==============================================================================
# Research Map — Unified Environment Configuration Reference
# ==============================================================================
# This root file is a master reference. In development, configure each service's
# local environment file individually:
#
#   1. Backend:   backend/.env        (copy from backend/.env.example)
#   2. AI Agent:  agent/.env          (copy from agent/.env.example)
#   3. Frontend:  frontend/.env.local (copy from frontend/.env.example)
#
# WARNING: NEVER commit .env or .env.local files containing real secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Go Gin + PostgreSQL / Neon) -> backend/.env
# ------------------------------------------------------------------------------
# Environment mode (development / production)
APP_ENV=development

# Listen address of the Go HTTP / WebSocket / MCP API server
API_ADDR=:8080

# Neon PostgreSQL connection string (DIRECT connection host, not pooled)
# Neon DB requires pgvector, pg_trgm, and pgcrypto extensions enabled.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Allowed CORS origins for credentials, cookies, and WebSockets (comma-separated)
WEB_ORIGINS=http://localhost:3000

# Secret key for signing httpOnly JWT session cookies (at least 32-64 random hex characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-64-character-hex-string

# Internal Python AI Agent service URL and mutual pre-shared authentication key
# IMPORTANT: AGENT_INTERNAL_KEY must match the key set in agent/.env!
AGENT_URL=http://127.0.0.1:8000
AGENT_INTERNAL_KEY=replace-with-secure-internal-shared-key-min-16-chars

# Database connection pool settings and migrations
DB_MAX_CONNS=10
MIGRATE_ON_START=true
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. AI AGENT SERVICE (Python FastAPI + Multi-Provider Pool) -> agent/.env
# ------------------------------------------------------------------------------
# Shared secret for internal Go <-> Python authentication (must match AGENT_INTERNAL_KEY in backend/.env)
# AGENT_INTERNAL_KEY=replace-with-secure-internal-shared-key-min-16-chars

# Google Gemini API Key Pool (Primary heavy reasoning: Agent 1, Agent 2, Conflicts, Reports)
# Keys are automatically rotated on rate-limits (429/quota limits)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Gemini Models per Task
GEMINI_MODEL=gemini-flash-latest
AGENT1_MODEL=gemini-flash-latest
AGENT2_MODEL=gemini-flash-latest
CONFLICT_MODEL=gemini-flash-latest
REPORT_MODEL=gemini-flash-latest

# Embeddings & Runtime Limits
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_TIMEOUT_SECONDS=45
AI_MAX_RPM=60

# ------------------------------------------------------------------------------
# 3. FRONTEND WEB APPLICATION (Next.js 16 + React 19) -> frontend/.env.local
# ------------------------------------------------------------------------------
# Frontend API mode: 'http' for real Go backend, 'mock' for in-browser client demo
NEXT_PUBLIC_API_MODE=http

# Next.js Server-only API proxy target (proxies /api/* to Go to preserve httpOnly cookies)
API_PROXY_TARGET=http://localhost:8080

# WebSocket URL for real-time collaboration updates
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws

# Chrome Extension ID (unpacked extension fixed by manifest.json public key)
NEXT_PUBLIC_EXTENSION_ID=bfphemfnigknpgmhiaknanilpjiifjlp

# API base URL for Chrome Extension direct capture requests
NEXT_PUBLIC_EXTENSION_API_BASE=http://localhost:8080/api/v1
