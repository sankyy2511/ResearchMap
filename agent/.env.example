# Python AI service (stateless, called only by Go). Copy to agent/.env and fill in. NEVER commit real keys.

# Shared secret with backend/.env AGENT_INTERNAL_KEY (min 16 chars)
AGENT_INTERNAL_KEY=same-value-as-backend-env-min-16-chars

# Gemini pool (heavy reasoning: Agent 1, Agent 2, conflicts, session report). Keys tried in order 1→4 on 429/quota/errors.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Gemini models per task
GEMINI_MODEL=gemini-flash-latest
AGENT1_MODEL=gemini-flash-latest
AGENT2_MODEL=gemini-flash-latest
CONFLICT_MODEL=gemini-flash-latest
REPORT_MODEL=gemini-flash-latest

# Limits
AI_TIMEOUT_SECONDS=45
AI_MAX_RPM=60
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOG_LEVEL=INFO
