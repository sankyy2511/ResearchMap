# ==============================================================================
# Research Map — Centralized Backend & AI Environment Reference
# ==============================================================================
# Copy this file to backend/.env and replace placeholders with real keys.
# NEVER commit backend/.env to Git!

# ------------------------------------------------------------------------------
# 1. CORE BACKEND SERVICE (Go Gin + Neon PostgreSQL)
# ------------------------------------------------------------------------------
APP_ENV=development
API_ADDR=:8080
# Neon PostgreSQL direct connection string (must have pgvector, pg_trgm, pgcrypto)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
WEB_ORIGINS=http://localhost:3000
# Secret key for httpOnly JWT session cookie (at least 32-64 random hex characters)
JWT_SECRET=change-me-to-64-random-hex-chars-at-least-32-characters
DB_MAX_CONNS=10
MIGRATE_ON_START=true
LOG_LEVEL=info

# Internal AI Service Connection & Shared Secret
AGENT_URL=http://127.0.0.1:8000
AGENT_INTERNAL_KEY=replace-with-secure-internal-shared-key-min-16-chars

# Email codes for sign-up and password reset (Gmail: use an app password).
# Without SMTP_USER, codes are written to the backend log (development only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# false: accounts are created without an email code and password reset by email is off
# (for hosts that block outgoing email).
EMAIL_VERIFICATION=true

# When the web app is hosted on another address (Firebase Hosting), the public address of this backend,
# for example https://api.example.com (no path). Leave empty for local development.
PUBLIC_API_URL=
# Behind a hosting proxy, trust its X-Forwarded-For header: TRUSTED_PROXIES=0.0.0.0/0,::/0
TRUSTED_PROXIES=127.0.0.1,::1

# Google sign-in (Google Cloud console > Google Auth Platform > Clients).
# Authorised redirect URI: <PUBLIC_API_URL or WEB_ORIGINS>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 2. AI INTELLIGENCE SERVICE (FastAPI Multi-Provider Pool & Model Configuration)
# ------------------------------------------------------------------------------
# Google Gemini API Key Pool (Primary heavy reasoning: Agent 1, Agent 2, Conflicts, Reports)
# Keys are automatically rotated on rate-limits (429/quota limits)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Models per Pipeline Task
GEMINI_MODEL=gemini-flash-latest
AGENT1_MODEL=gemini-flash-latest
AGENT2_MODEL=gemini-flash-latest
CONFLICT_MODEL=gemini-flash-latest
REPORT_MODEL=gemini-flash-latest

# FastEmbed Local ONNX Embeddings & Limits
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_TIMEOUT_SECONDS=45
AI_MAX_RPM=60

# ------------------------------------------------------------------------------
# 3. FRONTEND & EXTENSION REFERENCE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_MODE=http
API_PROXY_TARGET=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
NEXT_PUBLIC_EXTENSION_ID=bfphemfnigknpgmhiaknanilpjiifjlp
NEXT_PUBLIC_EXTENSION_API_BASE=http://localhost:8080/api/v1
